---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

// 传给内联脚本的可序列化文案
const strings = {
	title: i18n(I18nKey.musicVisualizer),
	noPlaying: i18n(I18nKey.musicNoPlaying),
	modeVisualize: i18n(I18nKey.musicModeVisualize),
	modePerform: i18n(I18nKey.musicModePerform),
	piano: i18n(I18nKey.musicInstrPiano),
	harmonica: i18n(I18nKey.musicInstrHarmonica),
	blow: i18n(I18nKey.musicHarmonicaBlow),
	draw: i18n(I18nKey.musicHarmonicaDraw),
	pianoHint: i18n(I18nKey.musicPianoHint),
	harmonicaHint: i18n(I18nKey.musicHarmonicaHint),
	canvasLabel: i18n(I18nKey.musicVisualizer),
};
---

<div class="card-base p-4 md:p-6 w-full relative">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-2 font-bold text-lg text-neutral-900 dark:text-neutral-100 transition relative ml-3
            before:w-1 before:h-4 before:rounded-md before:bg-(--primary)
            before:absolute before:-left-3 before:top-1/2 before:-translate-y-1/2">
            <Icon name="material-symbols:graphic-eq" class="text-[1.25rem] text-(--primary)" aria-hidden="true" />
            <span>{strings.title}</span>
        </div>
        <div class="flex items-center gap-2">
            <div id="midi-now-playing" class="hidden sm:block text-sm text-neutral-500 dark:text-neutral-400 truncate max-w-[42%] text-right" aria-live="polite">
                {strings.noPlaying}
            </div>
            <div class="flex items-center gap-1 p-0.5 rounded-lg bg-(--btn-regular-bg) text-sm shrink-0" role="tablist">
                <button id="midi-mode-viz" type="button" role="tab" aria-selected="true" class="px-3 py-1 rounded-md transition-all active:scale-95">
                    {strings.modeVisualize}
                </button>
                <button id="midi-mode-play" type="button" role="tab" aria-selected="false" class="px-3 py-1 rounded-md transition-all active:scale-95">
                    {strings.modePerform}
                </button>
            </div>
        </div>
    </div>

    <div id="midi-perform-bar" class="hidden flex-wrap items-center gap-2 mb-3">
        <div class="flex items-center gap-1 p-0.5 rounded-lg bg-(--btn-regular-bg) text-sm shrink-0">
            <button id="midi-instr-piano" type="button" class="px-3 py-1 rounded-md transition-all active:scale-95">
                {strings.piano}
            </button>
            <button id="midi-instr-harmonica" type="button" class="px-3 py-1 rounded-md transition-all active:scale-95">
                {strings.harmonica}
            </button>
        </div>
        <div id="midi-hint" class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed"></div>
    </div>

    <div class="relative w-full rounded-(--radius-large) overflow-hidden bg-neutral-950">
        <canvas id="midi-canvas" class="block w-full" aria-label={strings.canvasLabel} role="img"></canvas>
        <div id="midi-overlay" class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-neutral-400 text-sm pointer-events-none transition-opacity duration-300">
            <Icon name="material-symbols:music-note" class="text-3xl opacity-60" aria-hidden="true" />
            <span>{strings.noPlaying}</span>
        </div>
    </div>
</div>

<script is:inline define:vars={{ strings }}>
(function () {
    var canvas = document.getElementById("midi-canvas");
    var overlay = document.getElementById("midi-overlay");
    var nowPlaying = document.getElementById("midi-now-playing");
    var modeVizBtn = document.getElementById("midi-mode-viz");
    var modePlayBtn = document.getElementById("midi-mode-play");
    var performBar = document.getElementById("midi-perform-bar");
    var instrPianoBtn = document.getElementById("midi-instr-piano");
    var instrHarmonicaBtn = document.getElementById("midi-instr-harmonica");
    var hintEl = document.getElementById("midi-hint");
    if (!canvas) return;

    // swup 导航回到本页时，先销毁上一实例，避免重复的动画循环
    if (window.__midiViz) {
        try { window.__midiViz.destroy(); } catch (e) {}
        window.__midiViz = null;
    }

    var ctx = canvas.getContext("2d");
    var dpr = Math.min(window.devicePixelRatio || 1, 2);

    // 卷帘音域：C3(48) ~ B5(83)，共 36 键
    var MIDI_LOW = 48;
    var NUM_KEYS = 36;
    // C C# D D# E F F# G G# A A# B
    var BLACK_PC = [false, true, false, true, false, false, true, false, true, false, true, false];

    // 演奏音域：C4(60) ~ B5(83)，正好落在卷帘右半部分
    var PIANO_LOW = 60;
    var PIANO_HIGH = 83;

    // 24 孔口琴 = 2 排 × 12 孔；上排吹音、下排吸音，均为 C 大调自然音阶
    var HOLE_COUNT = 12;
    var BLOW_NOTES = [60, 62, 64, 65, 67, 69, 71, 72, 74, 76, 77, 79]; // C4 D4 E4 F4 G4 A4 B4 C5 D5 E5 F5 G5
    var DRAW_NOTES = [62, 64, 65, 67, 69, 71, 72, 74, 76, 77, 79, 81]; // D4 E4 F4 G4 A4 B4 C5 D5 E5 F5 G5 A5
    // 键位：吹音走数字行，吸音走字母行
    var BLOW_KEYS = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0", "-", "="];
    var DRAW_KEYS = ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p", "[", "]"];
    // 钢琴键位：低八度 Z 行 + 黑键 S 行，高八度 Q 行 + 黑键数字行
    var PIANO_KEYMAP = {
        z: 60, s: 61, x: 62, d: 63, c: 64, v: 65, g: 66, b: 67, h: 68, n: 69, j: 70, m: 71,
        q: 72, "2": 73, w: 74, "3": 75, e: 76, r: 77, "5": 78, t: 79, "6": 80, y: 81, "7": 82, u: 83
    };

    var KEYBOARD_H_VIZ = 54;
    var KEYBOARD_H_PERFORM = 104;
    var STEP = 2; // 每帧向下滚动像素
    var MAX_VOICES = 16;

    var mode = "viz"; // "viz" | "perform"
    var instrument = "piano"; // "piano" | "harmonica"

    var W = 0, H = 0, WATERFALL_H = 0, KEYBOARD_H = KEYBOARD_H_VIZ;
    var history = null, hctx = null;

    var keys = [];
    var pianoKeys = [];
    var freqRange = [];
    var liveEnergy = new Float32Array(NUM_KEYS);
    var manualEnergy = new Float32Array(NUM_KEYS);
    var analyser = null;
    var freqData = null;
    var isPlaying = false;
    var rafId = null;
    var themeHue = 165;
    var themeMono = false;
    var lastThemeSync = 0;

    // ── 合成器状态 ───────────────────────────────────────────
    var actx = null;
    var masterGain = null;
    var voices = {}; // "note:kind" -> { note, env, filter, oscs }
    var held = {}; // note -> 按下次数（键盘与鼠标可能同时按同一个音）

    // ── 主题色 ───────────────────────────────────────────────
    function readTheme() {
        var cs = getComputedStyle(document.documentElement);
        var hueVal = parseFloat(cs.getPropertyValue("--hue"));
        themeHue = isNaN(hueVal) ? 165 : hueVal;
        var chroma = parseFloat(cs.getPropertyValue("--hue-chroma"));
        themeMono = chroma === 0;
    }

    function barColor(v) {
        var alpha = 0.25 + 0.75 * v;
        var light = themeMono ? 92 - v * 45 : 46 + v * 38;
        return themeMono
            ? "hsla(0, 0%, " + light + "%, " + alpha + ")"
            : "hsla(" + themeHue + ", 85%, " + light + "%, " + alpha + ")";
    }

    function activeColor() {
        return themeMono ? "#6b7280" : "hsl(" + themeHue + ", 72%, 46%)";
    }

    // ── 布局与琴键几何 ───────────────────────────────────────
    function buildKeys() {
        keys = [];
        var whiteCount = 0;
        var i;
        for (i = 0; i < NUM_KEYS; i++) {
            var midi = MIDI_LOW + i;
            var black = BLACK_PC[midi % 12];
            keys.push({ midi: midi, black: black });
            if (!black) whiteCount++;
        }
        var whiteW = W / whiteCount;
        var blackW = whiteW * 0.62;
        var wc = 0;
        for (i = 0; i < keys.length; i++) {
            var k = keys[i];
            if (!k.black) {
                k.cx = (wc + 0.5) * whiteW;
                k.laneW = whiteW;
                wc++;
            } else {
                k.cx = wc * whiteW;
                k.laneW = blackW;
            }
            k.x0 = k.cx - k.laneW / 2;
        }
    }

    function buildPianoKeys() {
        pianoKeys = [];
        var whites = [];
        var blacks = [];
        var i, midi;
        for (midi = PIANO_LOW; midi <= PIANO_HIGH; midi++) {
            if (BLACK_PC[midi % 12]) blacks.push(midi);
            else whites.push(midi);
        }
        var whiteW = W / whites.length;
        var blackW = whiteW * 0.62;
        var whiteIndex = {};
        for (i = 0; i < whites.length; i++) whiteIndex[whites[i]] = i;
        for (i = 0; i < whites.length; i++) {
            pianoKeys.push({ midi: whites[i], black: false, x0: i * whiteW, w: whiteW });
        }
        for (i = 0; i < blacks.length; i++) {
            var bm = blacks[i];
            var li = 0;
            for (var p = bm - 1; p >= PIANO_LOW; p--) {
                if (!BLACK_PC[p % 12]) { li = whiteIndex[p]; break; }
            }
            var cx = (li + 1) * whiteW;
            pianoKeys.push({ midi: bm, black: true, x0: cx - blackW / 2, w: blackW });
        }
    }

    function layout() {
        var rect = canvas.getBoundingClientRect();
        W = Math.max(280, Math.floor(rect.width));
        if (mode === "viz") {
            H = Math.round(Math.min(400, Math.max(240, W * 0.42)));
            KEYBOARD_H = KEYBOARD_H_VIZ;
        } else {
            H = Math.round(Math.min(460, Math.max(300, W * 0.5)));
            KEYBOARD_H = KEYBOARD_H_PERFORM;
        }
        WATERFALL_H = H - KEYBOARD_H;

        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        canvas.style.height = H + "px";
        canvas.style.touchAction = mode === "perform" ? "none" : "";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        history = document.createElement("canvas");
        history.width = Math.round(W * dpr);
        history.height = Math.round(WATERFALL_H * dpr);
        hctx = history.getContext("2d");
        hctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        buildKeys();
        buildPianoKeys();
    }

    // ── 音频分析（播放器） ───────────────────────────────────
    function buildFreqRange() {
        var sr = analyser.context.sampleRate;
        var binHz = sr / analyser.fftSize;
        var n = analyser.frequencyBinCount;
        freqRange = [];
        for (var i = 0; i < NUM_KEYS; i++) {
            var f = 440 * Math.pow(2, (MIDI_LOW + i - 69) / 12);
            var b0 = Math.max(0, Math.floor((f * Math.pow(2, -0.5 / 12)) / binHz));
            var b1 = Math.min(n - 1, Math.max(b0, Math.ceil((f * Math.pow(2, 0.5 / 12)) / binHz)));
            freqRange.push([b0, b1]);
        }
    }

    function attachAnalyser() {
        if (analyser) return;
        var mgr = window.__fireflyMusic;
        if (!mgr || typeof mgr.ensureAnalyser !== "function") return;
        var a = mgr.ensureAnalyser();
        if (!a) return;
        analyser = a;
        freqData = new Uint8Array(a.frequencyBinCount);
        buildFreqRange();
    }

    function analyseEnergy() {
        analyser.getByteFrequencyData(freqData);
        var out = new Float32Array(NUM_KEYS);
        var total = 0;
        for (var i = 0; i < NUM_KEYS; i++) {
            var r = freqRange[i];
            var max = 0;
            for (var b = r[0]; b <= r[1]; b++) {
                if (freqData[b] > max) max = freqData[b];
            }
            total += max;
            out[i] = Math.pow(max / 255, 1.4);
        }
        // 跨域音频被 Web Audio 静音时，分析数据恒为 0 —— 标记为无效，交由兜底律动接管
        return total === 0 ? null : out;
    }

    // 无有效分析数据时的兜底律动，保证界面不会完全静止
    function synthEnergy() {
        var out = new Float32Array(NUM_KEYS);
        for (var j = 0; j < 2; j++) {
            if (Math.random() < 0.35) {
                out[Math.floor(Math.random() * NUM_KEYS)] = 0.45 + Math.random() * 0.55;
            }
        }
        return out;
    }

    // 播放中取一帧能量：优先真实分析数据，取不到（无节点 / 数据全零）则用兜底律动
    function currentEnergy() {
        if (!isPlaying) return null;
        if (!analyser) attachAnalyser();
        if (!analyser) return null;
        return analyseEnergy();
    }

    // ── 合成器 ───────────────────────────────────────────────
    function midiToFreq(note) {
        return 440 * Math.pow(2, (note - 69) / 12);
    }

    function ensureAudio() {
        if (actx) {
            if (actx.state === "suspended") actx.resume().catch(function () {});
            return actx;
        }
        var AC = window.AudioContext;
        if (!AC) return null;
        actx = new AC();
        masterGain = actx.createGain();
        masterGain.gain.value = 0.32;
        masterGain.connect(actx.destination);
        return actx;
    }

    function startVoice(note, kind) {
        var ac = ensureAudio();
        if (!ac) return;
        var id = note + ":" + kind;
        if (voices[id]) return;

        var ids = Object.keys(voices);
        if (ids.length >= MAX_VOICES) releaseVoice(ids[0]);

        var now = ac.currentTime;
        var f = midiToFreq(note);
        var env = ac.createGain();
        env.gain.value = 0;
        var filter = ac.createBiquadFilter();
        env.connect(filter);
        filter.connect(masterGain);

        var oscs = [];
        var o1, o2, o3, g;
        if (kind === "piano") {
            // 三角波基音 + 两个正弦泛音，衰减包络模拟敲击
            o1 = ac.createOscillator(); o1.type = "triangle"; o1.frequency.value = f;
            g = ac.createGain(); g.gain.value = 0.85; o1.connect(g); g.connect(env);
            o2 = ac.createOscillator(); o2.type = "sine"; o2.frequency.value = f * 2;
            g = ac.createGain(); g.gain.value = 0.16; o2.connect(g); g.connect(env);
            o3 = ac.createOscillator(); o3.type = "sine"; o3.frequency.value = f * 3;
            g = ac.createGain(); g.gain.value = 0.05; o3.connect(g); g.connect(env);
            filter.type = "lowpass";
            filter.frequency.value = Math.min(9000, f * 8 + 1200);
            filter.Q.value = 0.6;
            oscs.push(o1, o2, o3);
            env.gain.setValueAtTime(0, now);
            env.gain.linearRampToValueAtTime(0.5, now + 0.006);
            env.gain.exponentialRampToValueAtTime(0.17, now + 0.36);
        } else {
            // 锯齿波轻微失谐 + 低通，配合颤音模拟簧片
            o1 = ac.createOscillator(); o1.type = "sawtooth"; o1.frequency.value = f;
            o2 = ac.createOscillator(); o2.type = "sawtooth"; o2.frequency.value = f * 1.006;
            var sg = ac.createGain(); sg.gain.value = 0.5;
            o1.connect(sg); o2.connect(sg); sg.connect(env);
            filter.type = "lowpass";
            filter.frequency.value = Math.min(6000, f * 6 + 900);
            filter.Q.value = 3;
            var lfo = ac.createOscillator(); lfo.type = "sine"; lfo.frequency.value = 5.5;
            var lfoGain = ac.createGain(); lfoGain.gain.value = f * 0.008;
            lfo.connect(lfoGain);
            lfoGain.connect(o1.frequency);
            lfoGain.connect(o2.frequency);
            lfo.start(now);
            oscs.push(o1, o2, lfo);
            env.gain.setValueAtTime(0, now);
            env.gain.linearRampToValueAtTime(0.34, now + 0.05);
            env.gain.linearRampToValueAtTime(0.28, now + 0.4);
        }

        for (var i = 0; i < oscs.length; i++) oscs[i].start(now);
        voices[id] = { env: env, filter: filter, oscs: oscs };
    }

    function releaseVoice(id) {
        var v = voices[id];
        if (!v) return;
        delete voices[id];
        if (!actx) return;
        var now = actx.currentTime;
        var g = v.env.gain;
        try {
            g.cancelScheduledValues(now);
            g.setValueAtTime(Math.max(g.value, 0.0001), now);
            g.exponentialRampToValueAtTime(0.0001, now + 0.16);
        } catch (e) {}
        for (var i = 0; i < v.oscs.length; i++) {
            try { v.oscs[i].stop(now + 0.2); } catch (e) {}
        }
        (function (vv) {
            setTimeout(function () {
                try { vv.env.disconnect(); } catch (e) {}
                try { vv.filter.disconnect(); } catch (e) {}
            }, 400);
        })(v);
    }

    function noteOn(note) {
        if (note < MIDI_LOW || note > MIDI_LOW + NUM_KEYS - 1) return;
        held[note] = (held[note] || 0) + 1;
        if (held[note] === 1) startVoice(note, instrument);
        manualEnergy[note - MIDI_LOW] = 1;
    }

    function noteOff(note) {
        if (!held[note]) return;
        held[note]--;
        if (held[note] <= 0) {
            delete held[note];
            releaseVoice(note + ":" + instrument);
        }
    }

    function allNotesOff() {
        held = {};
        var ids = Object.keys(voices);
        for (var i = 0; i < ids.length; i++) releaseVoice(ids[i]);
    }

    // ── 键盘与鼠标输入 ───────────────────────────────────────
    function keyToNote(key) {
        if (instrument === "piano") {
            return PIANO_KEYMAP[key] === undefined ? -1 : PIANO_KEYMAP[key];
        }
        var i = BLOW_KEYS.indexOf(key);
        if (i >= 0) return BLOW_NOTES[i];
        i = DRAW_KEYS.indexOf(key);
        if (i >= 0) return DRAW_NOTES[i];
        return -1;
    }

    function isTextTarget(el) {
        if (!el) return false;
        var tag = el.tagName;
        return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || el.isContentEditable;
    }

    function onKeyDown(e) {
        if (mode !== "perform") return;
        if (e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
        if (isTextTarget(e.target)) return;
        var note = keyToNote((e.key || "").toLowerCase());
        if (note < 0) return;
        e.preventDefault();
        noteOn(note);
    }

    function onKeyUp(e) {
        if (mode !== "perform") return;
        if (isTextTarget(e.target)) return;
        var note = keyToNote((e.key || "").toLowerCase());
        if (note < 0) return;
        noteOff(note);
    }

    function hitTest(x, y) {
        if (mode !== "perform") return -1;
        if (y < WATERFALL_H || y > H) return -1;
        if (instrument === "piano") {
            var i, k;
            for (i = 0; i < pianoKeys.length; i++) {
                k = pianoKeys[i];
                if (k.black && x >= k.x0 && x <= k.x0 + k.w) return k.midi;
            }
            for (i = 0; i < pianoKeys.length; i++) {
                k = pianoKeys[i];
                if (!k.black && x >= k.x0 && x <= k.x0 + k.w) return k.midi;
            }
            return -1;
        }
        var col = Math.floor(x / (W / HOLE_COUNT));
        var row = Math.floor((y - WATERFALL_H) / (KEYBOARD_H / 2));
        if (col < 0 || col >= HOLE_COUNT || row < 0 || row > 1) return -1;
        return row === 0 ? BLOW_NOTES[col] : DRAW_NOTES[col];
    }

    var pointerNote = -1;
    var pointerDown = false;

    function pointerPos(e) {
        var rect = canvas.getBoundingClientRect();
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    }

    function onPointerDown(e) {
        if (mode !== "perform") return;
        var p = pointerPos(e);
        var note = hitTest(p.x, p.y);
        if (note < 0) return;
        e.preventDefault();
        pointerDown = true;
        pointerNote = note;
        try { canvas.setPointerCapture(e.pointerId); } catch (err) {}
        noteOn(note);
    }

    function onPointerMove(e) {
        if (!pointerDown) return;
        var p = pointerPos(e);
        var note = hitTest(p.x, p.y);
        if (note === pointerNote) return;
        if (pointerNote >= 0) noteOff(pointerNote);
        pointerNote = note;
        if (note >= 0) noteOn(note);
    }

    function endPointer() {
        if (!pointerDown) return;
        pointerDown = false;
        if (pointerNote >= 0) noteOff(pointerNote);
        pointerNote = -1;
    }

    // ── 绘制 ─────────────────────────────────────────────────
    function pushRow(energy) {
        // 整体向下位移 STEP 像素，新数据画在顶部
        var shift = Math.round(STEP * dpr);
        var sh = history.height - shift;
        if (sh > 0) {
            hctx.drawImage(history, 0, 0, history.width, sh, 0, shift, history.width, sh);
        }
        hctx.clearRect(0, 0, W, STEP + 1);
        for (var i = 0; i < NUM_KEYS; i++) {
            var v = energy[i];
            if (v < 0.05) continue;
            var k = keys[i];
            hctx.fillStyle = barColor(v);
            hctx.fillRect(k.x0, 0, k.laneW, STEP + 1);
        }
    }

    function drawKeyboard() {
        var y = WATERFALL_H;
        var kh = KEYBOARD_H;
        var i, k;

        ctx.fillStyle = "#f4f4f5";
        ctx.fillRect(0, y, W, kh);

        // 白键上的实时高亮
        for (i = 0; i < keys.length; i++) {
            k = keys[i];
            if (k.black) continue;
            if (liveEnergy[i] > 0.2) {
                ctx.fillStyle = barColor(liveEnergy[i]);
                ctx.fillRect(k.x0, y, k.laneW, kh);
            }
            ctx.fillStyle = "rgba(0,0,0,0.12)";
            ctx.fillRect(Math.round(k.x0), y, 1, kh);
        }

        // 黑键
        for (i = 0; i < keys.length; i++) {
            k = keys[i];
            if (!k.black) continue;
            ctx.fillStyle = liveEnergy[i] > 0.2 ? barColor(liveEnergy[i]) : "#1a1a1a";
            ctx.fillRect(k.cx - k.laneW / 2, y, k.laneW, kh * 0.62);
        }

        ctx.fillStyle = "rgba(255,255,255,0.18)";
        ctx.fillRect(0, y, W, 1);
    }

    function drawPiano() {
        var y = WATERFALL_H;
        var kh = KEYBOARD_H;
        var i, k, active;

        ctx.fillStyle = "#f4f4f5";
        ctx.fillRect(0, y, W, kh);

        ctx.font = "10px system-ui, sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "bottom";
        var labelW = W / 14;
        for (i = 0; i < pianoKeys.length; i++) {
            k = pianoKeys[i];
            if (k.black) continue;
            active = !!held[k.midi];
            ctx.fillStyle = active ? activeColor() : "#f4f4f5";
            ctx.fillRect(k.x0, y, k.w, kh);
            ctx.fillStyle = "rgba(0,0,0,0.14)";
            ctx.fillRect(Math.round(k.x0), y, 1, kh);
            if (labelW >= 22) {
                ctx.fillStyle = active ? "rgba(255,255,255,0.9)" : "rgba(0,0,0,0.35)";
                ctx.fillText(labelForNote(k.midi), k.x0 + k.w / 2, y + kh - 6);
            }
        }
        for (i = 0; i < pianoKeys.length; i++) {
            k = pianoKeys[i];
            if (!k.black) continue;
            active = !!held[k.midi];
            ctx.fillStyle = active ? activeColor() : "#1a1a1a";
            ctx.fillRect(k.x0, y, k.w, kh * 0.62);
        }
        ctx.fillStyle = "rgba(255,255,255,0.18)";
        ctx.fillRect(0, y, W, 1);
    }

    function drawHarmonica() {
        var y = WATERFALL_H;
        var rowH = KEYBOARD_H / 2;
        var colW = W / HOLE_COUNT;
        var i;

        ctx.fillStyle = "#1f2937";
        ctx.fillRect(0, y, W, KEYBOARD_H);

        ctx.font = "10px system-ui, sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";

        for (i = 0; i < HOLE_COUNT; i++) {
            var note = BLOW_NOTES[i];
            var active = !!held[note];
            var cx = i * colW;
            var pad = Math.max(1.5, colW * 0.08);
            ctx.fillStyle = active ? activeColor() : "#e5e7eb";
            roundRect(cx + pad, y + pad, colW - pad * 2, rowH - pad * 2, 5);
            ctx.fillStyle = active ? "rgba(255,255,255,0.95)" : "rgba(0,0,0,0.55)";
            if (colW >= 20) ctx.fillText(String(i + 1), cx + colW / 2, y + rowH / 2);
        }
        for (i = 0; i < HOLE_COUNT; i++) {
            note = DRAW_NOTES[i];
            active = !!held[note];
            cx = i * colW;
            pad = Math.max(1.5, colW * 0.08);
            ctx.fillStyle = active ? activeColor() : "#d1d5db";
            roundRect(cx + pad, y + rowH + pad, colW - pad * 2, rowH - pad * 2, 5);
            ctx.fillStyle = active ? "rgba(255,255,255,0.95)" : "rgba(0,0,0,0.55)";
            if (colW >= 20) ctx.fillText(String(i + 1), cx + colW / 2, y + rowH * 1.5);
        }

        ctx.fillStyle = "rgba(255,255,255,0.18)";
        ctx.fillRect(0, y, W, 1);
    }

    function roundRect(x, yy, w, h, r) {
        ctx.beginPath();
        ctx.moveTo(x + r, yy);
        ctx.arcTo(x + w, yy, x + w, yy + h, r);
        ctx.arcTo(x + w, yy + h, x, yy + h, r);
        ctx.arcTo(x, yy + h, x, yy, r);
        ctx.arcTo(x, yy, x + w, yy, r);
        ctx.closePath();
        ctx.fill();
    }

    function labelForNote(midi) {
        var names = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
        return names[midi % 12] + (Math.floor(midi / 12) - 1);
    }

    function render() {
        ctx.clearRect(0, 0, W, H);
        if (history) {
            // history 与目标尺寸一致（已被 setTransform 缩放），无需再次重采样
            ctx.drawImage(history, 0, 0);
        }
        if (mode === "perform") {
            if (instrument === "piano") drawPiano();
            else drawHarmonica();
        } else {
            drawKeyboard();
        }
    }

    // ── 主循环 ───────────────────────────────────────────────
    function decayManualEnergy() {
        var i;
        for (i = 0; i < NUM_KEYS; i++) {
            if (manualEnergy[i] > 0 && !held[i + MIDI_LOW]) manualEnergy[i] *= 0.88;
            if (manualEnergy[i] < 0.02) manualEnergy[i] = 0;
        }
    }

    function frame() {
        rafId = requestAnimationFrame(frame);
        var now = performance.now();
        if (now - lastThemeSync > 1000) {
            lastThemeSync = now;
            readTheme();
        }

        var energy, i;
        if (mode === "perform") {
            // 演奏模式下卷帘持续滚动，弹奏的音符直接落在卷帘上
            var played = currentEnergy();
            energy = new Float32Array(NUM_KEYS);
            for (i = 0; i < NUM_KEYS; i++) {
                var pv = played ? played[i] : 0;
                energy[i] = pv > manualEnergy[i] ? pv : manualEnergy[i];
            }
            if (!played && isPlaying) {
                var fallback = synthEnergy();
                for (i = 0; i < NUM_KEYS; i++) {
                    if (fallback[i] > energy[i]) energy[i] = fallback[i];
                }
            }
            pushRow(energy);
            liveEnergy = energy;
            decayManualEnergy();
        } else if (isPlaying) {
            var analysed = currentEnergy();
            energy = analysed || synthEnergy();
            liveEnergy = energy;
            pushRow(energy);
        } else {
            liveEnergy = new Float32Array(NUM_KEYS);
        }

        render();
    }

    // ── 播放器状态同步 ───────────────────────────────────────
    function updateNowPlaying() {
        var mgr = window.__fireflyMusic;
        var st = mgr && mgr.getState ? mgr.getState() : null;
        if (st && st.track) {
            nowPlaying.textContent = st.track.artist
                ? st.track.name + " · " + st.track.artist
                : st.track.name;
        } else {
            nowPlaying.textContent = strings.noPlaying;
        }
    }

    function setOverlay(visible) {
        overlay.style.opacity = visible ? "1" : "0";
    }

    function onPlayState(e) {
        isPlaying = !!(e.detail && e.detail.isPlaying);
        setOverlay(mode === "viz" && !isPlaying);
        if (isPlaying) attachAnalyser();
    }

    function onTrack() {
        updateNowPlaying();
    }

    function onResize() {
        layout();
    }

    function onWindowBlur() {
        allNotesOff();
    }

    // ── 模式与乐器切换 ───────────────────────────────────────
    function setActive(btn, on) {
        if (!btn) return;
        btn.classList.toggle("bg-(--primary)", on);
        btn.classList.toggle("text-white", on);
        btn.classList.toggle("text-neutral-600", !on);
        btn.classList.toggle("dark:text-neutral-300", !on);
        btn.setAttribute("aria-selected", on ? "true" : "false");
    }

    function updateHint() {
        if (mode !== "perform") {
            hintEl.textContent = "";
            return;
        }
        hintEl.textContent = instrument === "piano" ? strings.pianoHint : strings.harmonicaHint;
    }

    function applyMode() {
        setActive(modeVizBtn, mode === "viz");
        setActive(modePlayBtn, mode === "perform");
        if (performBar) {
            performBar.classList.toggle("hidden", mode !== "perform");
            performBar.classList.toggle("flex", mode === "perform");
        }
        setActive(instrPianoBtn, instrument === "piano");
        setActive(instrHarmonicaBtn, instrument === "harmonica");
        updateHint();
        setOverlay(mode === "viz" && !isPlaying);
        layout();
    }

    function switchMode(next) {
        if (mode === next) return;
        allNotesOff();
        mode = next;
        applyMode();
    }

    function switchInstrument(next) {
        if (instrument === next) return;
        allNotesOff();
        instrument = next;
        applyMode();
    }

    function destroy() {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = null;
        allNotesOff();
        window.removeEventListener("fm:play-state", onPlayState);
        window.removeEventListener("fm:track", onTrack);
        window.removeEventListener("fm:init", onTrack);
        window.removeEventListener("resize", onResize);
        window.removeEventListener("keydown", onKeyDown);
        window.removeEventListener("keyup", onKeyUp);
        window.removeEventListener("blur", onWindowBlur);
        canvas.removeEventListener("pointerdown", onPointerDown);
        canvas.removeEventListener("pointermove", onPointerMove);
        canvas.removeEventListener("pointerup", endPointer);
        canvas.removeEventListener("pointercancel", endPointer);
        canvas.removeEventListener("pointerleave", endPointer);
        if (actx) {
            try { actx.close(); } catch (e) {}
            actx = null;
        }
    }

    window.addEventListener("fm:play-state", onPlayState);
    window.addEventListener("fm:track", onTrack);
    window.addEventListener("fm:init", onTrack);
    window.addEventListener("resize", onResize);
    window.addEventListener("keydown", onKeyDown);
    window.addEventListener("keyup", onKeyUp);
    window.addEventListener("blur", onWindowBlur);
    canvas.addEventListener("pointerdown", onPointerDown);
    canvas.addEventListener("pointermove", onPointerMove);
    canvas.addEventListener("pointerup", endPointer);
    canvas.addEventListener("pointercancel", endPointer);
    canvas.addEventListener("pointerleave", endPointer);
    if (modeVizBtn) modeVizBtn.addEventListener("click", function () { switchMode("viz"); });
    if (modePlayBtn) modePlayBtn.addEventListener("click", function () { switchMode("perform"); });
    if (instrPianoBtn) instrPianoBtn.addEventListener("click", function () { switchInstrument("piano"); });
    if (instrHarmonicaBtn) instrHarmonicaBtn.addEventListener("click", function () { switchInstrument("harmonica"); });

    window.__midiViz = { destroy: destroy };

    requestAnimationFrame(function () {
        readTheme();
        var st = window.__fireflyMusic && window.__fireflyMusic.getState
            ? window.__fireflyMusic.getState()
            : null;
        isPlaying = !!(st && st.isPlaying);
        applyMode();
        updateNowPlaying();
        frame();
    });
})();
</script>