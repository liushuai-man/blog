---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

// 传给内联脚本的可序列化文案
const strings = {
	title: i18n(I18nKey.musicVisualizer),
	noPlaying: i18n(I18nKey.musicNoPlaying),
};
---

<div class="card-base p-4 md:p-6 w-full relative">
    <div class="flex items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-2 font-bold text-lg text-neutral-900 dark:text-neutral-100 transition relative ml-3
            before:w-1 before:h-4 before:rounded-md before:bg-(--primary)
            before:absolute before:-left-3 before:top-1/2 before:-translate-y-1/2">
            <Icon name="material-symbols:graphic-eq" class="text-[1.25rem] text-(--primary)" aria-hidden="true" />
            <span>{strings.title}</span>
        </div>
        <div id="midi-now-playing" class="text-sm text-neutral-500 dark:text-neutral-400 truncate max-w-[60%] text-right" aria-live="polite">
            {strings.noPlaying}
        </div>
    </div>

    <div class="relative w-full rounded-(--radius-large) overflow-hidden bg-neutral-950">
        <canvas id="midi-canvas" class="block w-full"></canvas>
        <div id="midi-overlay" class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-neutral-400 text-sm pointer-events-none transition-opacity duration-300">
            <Icon name="material-symbols:music-note" class="text-3xl opacity-60" aria-hidden="true" />
            <span>{strings.noPlaying}</span>
        </div>
    </div>
</div>

<script is:inline define:vars={{ strings }}>
(function () {
    var canvas = document.getElementById("midi-canvas");
    var overlay = document.getElementById("midi-overlay");
    var nowPlaying = document.getElementById("midi-now-playing");
    if (!canvas) return;

    // swup 导航回到本页时，先销毁上一实例，避免重复的动画循环
    if (window.__midiViz) {
        try { window.__midiViz.destroy(); } catch (e) {}
        window.__midiViz = null;
    }

    var ctx = canvas.getContext("2d");
    var dpr = Math.min(window.devicePixelRatio || 1, 2);

    // 键盘范围：C3(48) ~ B5(83)，共 36 键
    var MIDI_LOW = 48;
    var NUM_KEYS = 36;
    // C C# D D# E F F# G G# A A# B
    var BLACK_PC = [false, true, false, true, false, false, true, false, true, false, true, false];

    var KEYBOARD_H = 54;
    var STEP = 2; // 每帧向下滚动像素

    var W = 0, H = 0, WATERFALL_H = 0;
    var history = null, hctx = null;

    var keys = [];
    var freqRange = [];
    var liveEnergy = new Float32Array(NUM_KEYS);
    var analyser = null;
    var freqData = null;
    var analyserAttempted = false;
    var isPlaying = false;
    var rafId = null;
    var themeHue = 165;
    var themeMono = false;
    var lastThemeSync = 0;

    // ── 主题色 ───────────────────────────────────────────────
    function readTheme() {
        var cs = getComputedStyle(document.documentElement);
        var hueVal = parseFloat(cs.getPropertyValue("--hue"));
        themeHue = isNaN(hueVal) ? 165 : hueVal;
        var chroma = parseFloat(cs.getPropertyValue("--hue-chroma"));
        themeMono = chroma === 0;
    }

    function barColor(v) {
        var alpha = 0.25 + 0.75 * v;
        var light = themeMono ? 92 - v * 45 : 46 + v * 38;
        return themeMono
            ? "hsla(0, 0%, " + light + "%, " + alpha + ")"
            : "hsla(" + themeHue + ", 85%, " + light + "%, " + alpha + ")";
    }

    // ── 布局与琴键几何 ───────────────────────────────────────
    function buildKeys() {
        keys = [];
        var whiteCount = 0;
        var i;
        for (i = 0; i < NUM_KEYS; i++) {
            var midi = MIDI_LOW + i;
            var black = BLACK_PC[midi % 12];
            keys.push({ midi: midi, black: black });
            if (!black) whiteCount++;
        }
        var whiteW = W / whiteCount;
        var blackW = whiteW * 0.62;
        var wc = 0;
        for (i = 0; i < keys.length; i++) {
            var k = keys[i];
            if (!k.black) {
                k.cx = (wc + 0.5) * whiteW;
                k.laneW = whiteW;
                wc++;
            } else {
                k.cx = wc * whiteW;
                k.laneW = blackW;
            }
            k.x0 = k.cx - k.laneW / 2;
        }
    }

    function layout() {
        var rect = canvas.getBoundingClientRect();
        W = Math.max(280, Math.floor(rect.width));
        H = Math.round(Math.min(400, Math.max(240, W * 0.42)));
        WATERFALL_H = H - KEYBOARD_H;

        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        canvas.style.height = H + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        history = document.createElement("canvas");
        history.width = Math.round(W * dpr);
        history.height = Math.round(WATERFALL_H * dpr);
        hctx = history.getContext("2d");
        hctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        buildKeys();
    }

    // ── 音频分析 ─────────────────────────────────────────────
    function buildFreqRange() {
        var sr = analyser.context.sampleRate;
        var binHz = sr / analyser.fftSize;
        var n = analyser.frequencyBinCount;
        freqRange = [];
        for (var i = 0; i < NUM_KEYS; i++) {
            var f = 440 * Math.pow(2, (MIDI_LOW + i - 69) / 12);
            var b0 = Math.max(0, Math.floor((f * Math.pow(2, -0.5 / 12)) / binHz));
            var b1 = Math.min(n - 1, Math.max(b0, Math.ceil((f * Math.pow(2, 0.5 / 12)) / binHz)));
            freqRange.push([b0, b1]);
        }
    }

    function attachAnalyser() {
        if (analyser || analyserAttempted) return;
        analyserAttempted = true;
        var mgr = window.__fireflyMusic;
        if (!mgr || typeof mgr.ensureAnalyser !== "function") return;
        var a = mgr.ensureAnalyser();
        if (!a) return;
        analyser = a;
        freqData = new Uint8Array(a.frequencyBinCount);
        buildFreqRange();
    }

    function analyseEnergy() {
        analyser.getByteFrequencyData(freqData);
        var out = new Float32Array(NUM_KEYS);
        for (var i = 0; i < NUM_KEYS; i++) {
            var r = freqRange[i];
            var max = 0;
            for (var b = r[0]; b <= r[1]; b++) {
                if (freqData[b] > max) max = freqData[b];
            }
            out[i] = Math.pow(max / 255, 1.4);
        }
        return out;
    }

    // 无分析节点时的兜底律动，保证界面不会完全静止
    function synthEnergy() {
        var out = new Float32Array(NUM_KEYS);
        var notes = 2;
        for (var j = 0; j < notes; j++) {
            if (Math.random() < 0.35) {
                out[Math.floor(Math.random() * NUM_KEYS)] = 0.45 + Math.random() * 0.55;
            }
        }
        return out;
    }

    // ── 绘制 ─────────────────────────────────────────────────
    function pushRow(energy) {
        // 整体向下位移 STEP 像素，新数据画在顶部
        var shift = Math.round(STEP * dpr);
        var sh = history.height - shift;
        if (sh > 0) {
            hctx.drawImage(history, 0, 0, history.width, sh, 0, shift, history.width, sh);
        }
        hctx.clearRect(0, 0, W, STEP + 1);
        for (var i = 0; i < NUM_KEYS; i++) {
            var v = energy[i];
            if (v < 0.05) continue;
            var k = keys[i];
            hctx.fillStyle = barColor(v);
            hctx.fillRect(k.x0, 0, k.laneW, STEP + 1);
        }
    }

    function drawKeyboard() {
        var y = WATERFALL_H;
        var kh = KEYBOARD_H;
        var i, k;

        ctx.fillStyle = "#f4f4f5";
        ctx.fillRect(0, y, W, kh);

        // 白键上的实时高亮
        for (i = 0; i < keys.length; i++) {
            k = keys[i];
            if (k.black) continue;
            if (liveEnergy[i] > 0.2) {
                ctx.fillStyle = barColor(liveEnergy[i]);
                ctx.fillRect(k.x0, y, k.laneW, kh);
            }
            ctx.fillStyle = "rgba(0,0,0,0.12)";
            ctx.fillRect(Math.round(k.x0), y, 1, kh);
        }

        // 黑键
        for (i = 0; i < keys.length; i++) {
            k = keys[i];
            if (!k.black) continue;
            ctx.fillStyle = liveEnergy[i] > 0.2 ? barColor(liveEnergy[i]) : "#1a1a1a";
            ctx.fillRect(k.cx - k.laneW / 2, y, k.laneW, kh * 0.62);
        }

        ctx.fillStyle = "rgba(255,255,255,0.18)";
        ctx.fillRect(0, y, W, 1);
    }

    function render() {
        ctx.clearRect(0, 0, W, H);
        if (history) {
            ctx.drawImage(history, 0, 0, history.width, history.height, 0, 0, W, WATERFALL_H);
        }
        drawKeyboard();
    }

    // ── 主循环 ───────────────────────────────────────────────
    function frame() {
        rafId = requestAnimationFrame(frame);
        var now = performance.now();
        if (now - lastThemeSync > 1000) {
            lastThemeSync = now;
            readTheme();
        }

        if (isPlaying) {
            var energy;
            if (analyser) {
                energy = analyseEnergy();
            } else {
                attachAnalyser();
                energy = analyser ? analyseEnergy() : synthEnergy();
            }
            liveEnergy = energy;
            pushRow(energy);
        } else {
            liveEnergy = new Float32Array(NUM_KEYS);
        }

        render();
    }

    // ── 播放器状态同步 ───────────────────────────────────────
    function updateNowPlaying() {
        var mgr = window.__fireflyMusic;
        var st = mgr && mgr.getState ? mgr.getState() : null;
        if (st && st.track) {
            nowPlaying.textContent = st.track.artist
                ? st.track.name + " · " + st.track.artist
                : st.track.name;
        } else {
            nowPlaying.textContent = strings.noPlaying;
        }
    }

    function setOverlay(visible) {
        overlay.style.opacity = visible ? "1" : "0";
    }

    function onPlayState(e) {
        isPlaying = !!(e.detail && e.detail.isPlaying);
        setOverlay(!isPlaying);
        if (isPlaying) attachAnalyser();
    }

    function onTrack() {
        updateNowPlaying();
    }

    function onResize() {
        layout();
    }

    function destroy() {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = null;
        window.removeEventListener("fm:play-state", onPlayState);
        window.removeEventListener("fm:track", onTrack);
        window.removeEventListener("fm:init", onTrack);
        window.removeEventListener("resize", onResize);
    }

    window.addEventListener("fm:play-state", onPlayState);
    window.addEventListener("fm:track", onTrack);
    window.addEventListener("fm:init", onTrack);
    window.addEventListener("resize", onResize);

    window.__midiViz = { destroy: destroy };

    requestAnimationFrame(function () {
        readTheme();
        layout();
        updateNowPlaying();
        var st = window.__fireflyMusic && window.__fireflyMusic.getState
            ? window.__fireflyMusic.getState()
            : null;
        isPlaying = !!(st && st.isPlaying);
        setOverlay(!isPlaying);
        frame();
    });
})();
</script>