---
import type { ToolDefinition } from "@/features/other/types";
import { url } from "@/utils/url-utils";
const { tool } = Astro.props as { tool: ToolDefinition };
---
<a href={url(tool.route)} class="card-base flex items-center gap-4 p-4 border border-(--line-divider) hover:border-(--primary) transition-colors">
	<div class="min-w-0 flex-1">
		<h2 class="text-lg font-bold text-90">{tool.title}</h2>
		<p class="text-50 text-sm mt-1">{tool.description}</p>
	</div>
	<span class="text-(--primary)" aria-hidden="true">↗</span>
</a>
