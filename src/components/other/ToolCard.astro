---
import type { ToolDefinition } from "@/features/other/types";
import { url } from "@/utils/url-utils";
const { tool } = Astro.props as { tool: ToolDefinition };
---
<a href={url(tool.route)} class="card-base block p-6 md:p-8 border border-(--line-divider) hover:border-(--primary) transition-colors">
	<p class="text-(--primary) text-sm font-medium mb-3">{tool.badge}</p>
	{tool.id === "stylophone" && <div class="flex gap-1 h-14 mb-6 max-w-72" aria-hidden="true">
		{Array.from({ length: 13 }, (_, i) => <span class:list={["flex-1 rounded-sm bg-(--btn-regular-bg) border border-(--line-divider)", [1,3,6,8,10].includes(i) && "mt-3"]} />)}
	</div>}
	<h2 class="text-2xl font-bold text-90 mb-3">{tool.title}</h2>
	<p class="text-75 leading-relaxed">{tool.description}</p>
	<p class="text-(--primary) mt-6 font-medium">开始玩 ↗</p>
</a>
